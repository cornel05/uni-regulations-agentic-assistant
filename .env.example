# ─────────────────────────────────────────────────────────────────────────────
# Credentials (required)
# ─────────────────────────────────────────────────────────────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://cloud.zilliz.com  →  cluster endpoint + an API key
ZILLIZ_CLOUD_ENDPOINT=
ZILLIZ_CLOUD_API_KEY=

# Shared secret for /api/admin/*. Leave empty to disable the admin API entirely.
ADMIN_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Models
# ─────────────────────────────────────────────────────────────────────────────
# Both must be model ids that are currently available to your API key — check with
# client.models.list(). A retired id (e.g. gemini-2.0-flash) returns 404; the app
# then moves on to the next candidate, so a dead FALLBACK_MODEL silently removes
# your safety net for exactly the outage it exists to cover.
MAIN_MODEL=gemini-2.5-flash
FALLBACK_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=3072
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=3072

# ─────────────────────────────────────────────────────────────────────────────
# Vector store
# ─────────────────────────────────────────────────────────────────────────────
MILVUS_COLLECTION_NAME=uni_regulations_v1
# Hybrid dense + BM25 retrieval. Set false to fall back to dense-only, e.g. if
# the deployment's Milvus build has no usable analyzer for Vietnamese.
ENABLE_SPARSE=true
UPSERT_BATCH_SIZE=32

# ─────────────────────────────────────────────────────────────────────────────
# Retrieval and confidence
# ─────────────────────────────────────────────────────────────────────────────
RETRIEVAL_K=5
RRF_K=60
# Weight of retrieval similarity against the model's own grounding rating.
CONFIDENCE_DENSE_WEIGHT=0.5
CONFIDENCE_HIGH_THRESHOLD=0.8
CONFIDENCE_MEDIUM_THRESHOLD=0.5

# ─────────────────────────────────────────────────────────────────────────────
# Sessions
# ─────────────────────────────────────────────────────────────────────────────
SESSION_MAX_TURNS=5
SESSION_TTL_SECONDS=3600

# ─────────────────────────────────────────────────────────────────────────────
# Ingestion
# ─────────────────────────────────────────────────────────────────────────────
REGULATION_PAGE_URL=https://hcmut.edu.vn/dao-tao/quy-che-quy-dinh
DATABASE_PATH=database/regulations.db
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
# hybrid | pymupdf_only | gemini
EXTRACTION_MODE=hybrid
# Extraction quality gate: below this score the PDF is re-read by the model.
PYMUPDF_QUALITY_THRESHOLD=0.75
# Characters a text-bearing page should yield; a scanned page falls far short.
EXPECTED_CHARS_PER_PAGE=400
EXTRACTION_MAX_OUTPUT_TOKENS=32768
EMBEDDING_RETRY_COUNT=3
EMBEDDING_RETRY_DELAY=1.5
LLM_RETRY_COUNT=2
# Base seconds between retries, multiplied by the attempt number. A chat request
# waits on this, so keep it small — 20s here means a transient 503 costs 40s
# before the answer fails.
LLM_RETRY_DELAY=2

# ─────────────────────────────────────────────────────────────────────────────
# Crawler
# ─────────────────────────────────────────────────────────────────────────────
HEADLESS_MODE=true
WAIT_TIME=20
DELAY_BETWEEN_REQUESTS=5
PDF_DOWNLOAD_TIMEOUT=60
CRAWL_INTERVAL_HOURS=168

# ─────────────────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
FRONTEND_DIST=frontend/dist
